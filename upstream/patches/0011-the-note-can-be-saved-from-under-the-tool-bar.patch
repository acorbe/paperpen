+// under the button that was pressed when it is on show, the ink's Keep;
+// otherwise under the right-hand end of the bar
+function placeQuickSave() {
+  const quick = document.getElementById('quick-save');
+  if (quick.hidden) return;
+  const bar = document.querySelector('.tools').getBoundingClientRect();
+  const keep = document.getElementById('ink-save');
+  const under = keep.hidden ? null : keep.getBoundingClientRect();
+  const w = quick.offsetWidth || 90;
+  const left = under ? under.left + (under.width - w) / 2 : bar.right - w - 12;
+  quick.style.top = (bar.bottom + 8) + 'px';
+  quick.style.left = Math.max(8, Math.min(left, window.innerWidth - w - 8)) + 'px';
+}
