+// On an iPad the Pencil scrolls the page like a finger unless told not to, and
+// the page is told only while the pen is seen hovering, which most iPads cannot
+// report: so the page slid under the Pencil and the ink landed off the line.
+// Safari marks a Pencil touch as a stylus, and that one is kept from scrolling
+// wherever the pen writes; a finger still scrolls.
+function writing(e) {
+  return TOOL === 'pen' || !pad.hidden;
+}
+for (const ev of ['touchstart', 'touchmove']) {
+  document.addEventListener(ev, (e) => {
+    if (!writing(e)) return;
+    if ([...e.changedTouches].some(t => t.touchType === 'stylus')
+        && e.target.closest && e.target.closest('.page, #pad')) {
+      e.preventDefault();
+    }
+  }, {passive: false});
+}
