+// Only the pages near the screen have a canvas the size of the page. iPad
+// Safari caps the memory of all canvases on a page, around 384 MB, and past it
+// a canvas is silently blank: a paper of twenty pages at the iPad's density
+// was most of that, a zoom took it past, and ink was written where it did not
+// show. A page far away gives its memory back and gets it again on the way.
+const MOST_PIXELS = 8e6;
+
+function nearScreen(box) {
+  const reach = window.innerHeight;
+  return box.bottom > -reach && box.top < window.innerHeight + reach;
+}
