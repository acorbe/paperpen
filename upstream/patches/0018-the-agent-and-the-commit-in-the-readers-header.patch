+function undoFix(note, fix, button) {
+  button.disabled = true;
+  postJSON('/paper/' + PID + '/feedback/undo', {note: note.id, fix: fix.id})
+    .then(data => {
+      if (!data.ok) throw new Error(data.error || 'unknown error');
+      toast('Taken back out; the note is open again.');
+      return load().then(() => {
+        const again = allNotes().find(n => n.id === note.id);
+        if (again) openNote(again);
+      });
+    })
+    .catch(err => { toast('Not undone: ' + err.message, 6000); button.disabled = false; });
+}
+
+// --- the agent, and what is waiting to be committed -------------------------
+// What claude is doing with the round, said in the header while it does it,
+// and the review's commit one tap away: on the branch you are on, or on one
+// of its own, to be taken or dropped.
+let agentPoll = null;
+
+function showAgentAndCommit() {
+  const said = document.getElementById('agent-said');
+  const ask = document.getElementById('ask-agent');
+  const a = (META && META.agent) || {};
+  const r = (META && META.review) || {};
+  said.hidden = !a.state;
+  said.className = 'agent-said ' + (a.state || '');
+  if (a.state === 'running') {
+    said.textContent = 'claude is answering the round of ' + a.round + '…';
+  } else if (a.state === 'failed') {
+    said.textContent = 'claude could not answer: ' + (a.said || 'see its log');
+  } else if (a.state === 'done') {
+    said.textContent = 'claude answered the round of ' + a.round
+      + (a.branch ? ', on ' + a.branch : '');
+  } else if (a.state === 'stopped') {
+    said.textContent = 'claude was stopped';
+  }
+  // someone to ask, and something to ask about: a sent note nobody has answered
+  const answers = (META && META.feedback) || {};
+  const unanswered = ((META && META.past) || []).some(n => !answered(n) && !answers[n.id]);
+  ask.hidden = !(a.mode && a.mode !== 'off' && a.state !== 'running' && unanswered);
+  ask.textContent = a.state && a.state !== 'running' ? 'Ask claude again' : 'Ask claude';
+
+  const n = r.to_commit || 0;
+  document.getElementById('commit').hidden = !n || r.review_branch;
+  document.getElementById('commit').textContent = 'Commit (' + n + ' note' + (n === 1 ? '' : 's') + ')';
+  document.getElementById('commit-branch').hidden = !n || r.review_branch;
+  document.getElementById('take').hidden = !r.review_branch;
+  document.getElementById('drop').hidden = !r.review_branch;
+  if (r.review_branch) {
+    document.getElementById('take').textContent = 'Take ' + r.branch;
+    if (n) {
+      document.getElementById('commit').hidden = false;    // more fixes on the branch
+    }
+  }
+  clearTimeout(agentPoll);
+  if (a.state === 'running') agentPoll = setTimeout(load, 10000);
+}
+
+function headerCall(url, body, done, button) {
+  button.disabled = true;
+  postJSON(url, body)
+    .then(data => {
+      if (!data.ok) throw new Error(data.error || 'unknown error');
+      toast(done(data), 6000);
+      return load();
+    })
+    .catch(err => toast(err.message, 6000))
+    .finally(() => { button.disabled = false; });
+}
+
