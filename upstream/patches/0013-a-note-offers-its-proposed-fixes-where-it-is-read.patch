+// --- a note's proposed fixes --------------------------------------------
+// Whoever answered a delivered round may have proposed fixes for its notes:
+// exact text in the source and what replaces it. They are offered here, in the
+// note, where it is being read, and one tap puts one in. The same fixes, all
+// of them at once, are at /paper/<id>/feedback.
+function answersOf(note) {
+  const all = (META && META.feedback) || {};
+  return (note && note.id && all[note.id]) || {fixes: [], thread: []};
+}
+
+function waitingFixes(note) {
+  if (!note || note.claude || note.status === 'done' || note.status === 'rejected') return [];
+  return answersOf(note).fixes.filter(f => f.state === 'proposed');
+}
+
+function fxMake(tag, cls, text) {
+  const node = document.createElement(tag);
+  if (cls) node.className = cls;
+  if (text !== undefined) node.textContent = text;
+  return node;
+}
+
+// word by word, each stretch of change shown whole: what goes, then what comes
+function fxDiff(old, neu) {
+  const split = t => t.split(/(\s+)/).filter(x => x.length);
+  const a = split(old), b = split(neu), box = fxMake('div', 'fx-diff');
+  if (a.length * b.length > 250000) {
+    box.append(fxMake('del', '', old), document.createTextNode(' '), fxMake('ins', '', neu));
+    return box;
+  }
+  const n = a.length, m = b.length;
+  const L = Array.from({length: n + 1}, () => new Uint16Array(m + 1));
+  for (let i = n - 1; i >= 0; i--) for (let j = m - 1; j >= 0; j--) {
+    L[i][j] = a[i] === b[j] ? L[i + 1][j + 1] + 1 : Math.max(L[i + 1][j], L[i][j + 1]);
+  }
+  const parts = [];
+  const add = (key, t) => {
+    const last = parts[parts.length - 1];
+    if (key === 'same') { if (last && 'same' in last) last.same += t; else parts.push({same: t}); }
+    else if (last && !('same' in last)) last[key] += t;
+    else parts.push(key === 'del' ? {del: t, ins: ''} : {del: '', ins: t});
+  };
+  let i = 0, j = 0;
+  while (i < n || j < m) {
+    if (i < n && j < m && a[i] === b[j]) { add('same', a[i]); i++; j++; }
+    else if (j < m && (i >= n || L[i][j + 1] >= L[i + 1][j])) { add('ins', b[j]); j++; }
+    else { add('del', a[i]); i++; }
+  }
+  const slight = t => !t.trim() || (t.trim().split(/\s+/).length === 1 && t.trim().length <= 3);
+  for (let changed = true; changed;) {
+    changed = false;
+    for (let k = 1; k + 1 < parts.length; k++) {
+      const p = parts[k - 1], q = parts[k], r = parts[k + 1];
+      if ('same' in q && !('same' in p) && !('same' in r) && slight(q.same)) {
+        parts.splice(k - 1, 3, {del: p.del + q.same + r.del, ins: p.ins + q.same + r.ins});
+        changed = true;
+        break;
+      }
+    }
+  }
+  for (const part of parts) {
+    if ('same' in part) { box.append(document.createTextNode(part.same)); continue; }
+    const edge = part.del || part.ins;
+    const lead = edge.match(/^\s*/)[0], trail = edge.match(/\s*$/)[0];
+    const gone = part.del.trim(), come = part.ins.trim();
+    if (lead) box.append(document.createTextNode(lead));
+    if (gone) box.append(fxMake('del', '', gone));
+    if (gone && come) box.append(document.createTextNode(' '));
+    if (come) box.append(fxMake('ins', '', come));
+    if (trail) box.append(document.createTextNode(trail));
+  }
+  return box;
+}
+
+function showFixes(note) {
+  const box = document.getElementById('sheet-fixes');
+  box.innerHTML = '';
+  const said = answersOf(note);
+  box.hidden = !(said.fixes.length || said.thread.length);
+  if (box.hidden) return;
+  const open = !(note.status === 'done' || note.status === 'rejected');
+  const waiting = said.fixes.filter(f => f.state === 'proposed').length;
+  box.append(fxMake('div', 'fx-head', waiting && open
+    ? (waiting === 1 ? 'A fix is proposed' : waiting + ' fixes are proposed: choose one')
+    : 'What came back'));
+  for (const fix of said.fixes) {
+    const card = fxMake('div', 'fx-card ' + fix.state);
+    const top = fxMake('div', 'fx-top');
+    const what = fxMake('div', 'fx-what', fix.summary);
+    what.append(fxMake('span', 'fx-by', fix.by));
+    top.append(what);
+    if (fix.state === 'proposed' && open) {
+      const use = fxMake('button', 'fx-use', 'Use this');
+      use.type = 'button';
+      use.onclick = () => useFix(note, fix, use);
+      top.append(use);
+    } else if (fix.state === 'applied') {
+      top.append(fxMake('span', 'fx-badge', 'applied'));
+    } else if (fix.state === 'failed') {
+      top.append(fxMake('span', 'fx-badge failed', 'did not apply'));
+    }
+    card.append(top);
+    if (fix.why) card.append(fxMake('div', 'fx-why', fix.why));
+    for (const e of fix.edits || []) {
+      card.append(fxMake('div', 'fx-file', e.file), fxDiff(e.old, e.new));
+    }
+    if (fix.problem) card.append(fxMake('div', 'fx-problem', fix.problem));
+    box.append(card);
+  }
+  for (const m of said.thread) {
+    const msg = fxMake('div', 'fx-msg' + (m.by === 'you' ? ' you' : ''));
+    msg.append(fxMake('span', 'fx-who', m.by), document.createTextNode(m.text));
+    box.append(msg);
+  }
+  if (open) {
+    const row = fxMake('div', 'fx-reply');
+    const input = fxMake('input');
+    input.placeholder = 'Reply: a further note, or which way to go';
+    const send = fxMake('button', '', 'Reply');
+    send.type = 'button';
+    send.onclick = () => replyTo(note, input, send);
+    row.append(input, send);
+    box.append(row);
+  }
+}
+
+function useFix(note, fix, button) {
+  button.disabled = true;
+  postJSON('/paper/' + PID + '/feedback/apply', {note: note.id, fixes: [fix.id]})
+    .then(data => {
+      if (!data.ok) throw new Error(data.error || 'unknown error');
+      const failed = Object.values(data.failed || {});
+      if (failed.length) throw new Error(failed[0]);
+      const files = [...new Set((fix.edits || []).map(e => e.file))].join(', ');
+      closeSheet();
+      load();
+      toast('Put into ' + files + ', and the note is closed. Rebuild to read it.', 5000);
+    })
+    .catch(err => { toast('Not applied: ' + err.message, 6000); button.disabled = false; load(); });
+}
+
+function replyTo(note, input, button) {
+  if (!input.value.trim()) { input.focus(); return; }
+  button.disabled = true;
+  postJSON('/paper/' + PID + '/feedback/reply', {note: note.id, text: input.value})
+    .then(data => {
+      if (!data.ok) throw new Error(data.error || 'unknown error');
+      toast('Said. The note stays open for whoever answers next.');
+      return load().then(() => {
+        const again = allNotes().find(n => n.id === note.id);
+        if (again && EDIT && EDIT.id === note.id) showFixes(again);
+      });
+    })
+    .catch(err => toast('Not sent: ' + err.message, 6000))
+    .finally(() => { button.disabled = false; });
+}
+
 function closeSheet() {
   document.getElementById('quick-save').hidden = true;
   document.getElementById('sheet').hidden = true;
