+// --- search ---------------------------------------------------------------
+// Orderless, as emacs has it: the words in any order, !word for without, a
+// capital to match case. The server reads every sentence of every page, and
+// the matches are drawn where they are on the pages and listed, emacs's
+// occur, each one a tap away.
+const FOUND = {q: '', matches: [], at: -1, more: false};
+let searchWait = null;
+
+function openSearch() {
+  const bar = document.getElementById('searchbar');
+  bar.hidden = false;
+  const q = document.getElementById('q');
+  q.focus();
+  q.select();
+}
+
+function closeSearch() {
+  document.getElementById('searchbar').hidden = true;
+  document.getElementById('occur').hidden = true;
+  document.getElementById('q-list').classList.remove('on');
+  FOUND.matches = []; FOUND.at = -1;
+  drawHits();
+}
+
+function runSearch() {
+  const q = document.getElementById('q').value.trim();
+  if (q === FOUND.q) return;
+  FOUND.q = q;
+  if (!q) { FOUND.matches = []; FOUND.at = -1; drawHits(); drawOccur(); countHits(); return; }
+  fetch('/paper/' + PID + '/search?q=' + encodeURIComponent(q))
+    .then(r => r.json())
+    .then(d => {
+      if (FOUND.q !== q) return;             // typed on since
+      FOUND.matches = d.matches || []; FOUND.more = !!d.more;
+      FOUND.at = FOUND.matches.length ? 0 : -1;
+      drawHits(); drawOccur(); countHits();
+      if (FOUND.at >= 0) goToHit(0, false);
+    })
+    .catch(() => {});
+}
+
+function countHits() {
+  const n = FOUND.matches.length;
+  document.getElementById('q-count').textContent = !FOUND.q ? ''
+    : n ? (FOUND.at + 1) + ' of ' + n + (FOUND.more ? '+' : '') : 'none';
+}
+
+function drawHits() {
+  for (const old of document.querySelectorAll('.hitband')) old.remove();
+  FOUND.matches.forEach((m, k) => {
+    const el = document.querySelector('.page[data-page="' + m.page + '"]');
+    if (!el || !META) return;
+    const size = META.build.sizes[m.page - 1];
+    for (const r of m.rects) {
+      const band = document.createElement('div');
+      band.className = 'hitband' + (k === FOUND.at ? ' now' : '');
+      band.dataset.k = k;
+      band.style.left = (100 * r[0] / size[0]) + '%';
+      band.style.top = (100 * r[1] / size[1]) + '%';
+      band.style.width = (100 * Math.max(r[2] - r[0], 3) / size[0]) + '%';
+      band.style.height = (100 * Math.max(r[3] - r[1], 3) / size[1]) + '%';
+      el.appendChild(band);
+    }
+  });
+}
+
+function drawOccur() {
+  const box = document.getElementById('occur');
+  box.innerHTML = '';
+  FOUND.matches.forEach((m, k) => {
+    const row = document.createElement('div');
+    row.className = 'row' + (k === FOUND.at ? ' now' : '');
+    const pg = document.createElement('span');
+    pg.className = 'pg';
+    pg.textContent = 'p. ' + m.page;
+    const said = document.createElement('span');
+    let at = 0;
+    for (const [a, b] of m.spans || []) {
+      if (a > at) said.appendChild(document.createTextNode(m.text.slice(at, a)));
+      const mk = document.createElement('mark');
+      mk.textContent = m.text.slice(a, b);
+      said.appendChild(mk);
+      at = b;
+    }
+    if (at < m.text.length) said.appendChild(document.createTextNode(m.text.slice(at)));
+    row.append(pg, said);
+    row.onclick = () => goToHit(k, true);
+    box.appendChild(row);
+  });
+  if (FOUND.more) {
+    const more = document.createElement('div');
+    more.className = 'more';
+    more.textContent = 'and more: another word narrows it';
+    box.appendChild(more);
+  }
+}
+
+function goToHit(k, fromList) {
+  if (!FOUND.matches.length) return;
+  FOUND.at = (k + FOUND.matches.length) % FOUND.matches.length;
+  const m = FOUND.matches[FOUND.at];
+  for (const b of document.querySelectorAll('.hitband')) {
+    b.classList.toggle('now', Number(b.dataset.k) === FOUND.at);
+  }
+  for (const r of document.querySelectorAll('#occur .row')) r.classList.remove('now');
+  const row = document.querySelectorAll('#occur .row')[FOUND.at];
+  if (row) { row.classList.add('now'); if (!fromList) row.scrollIntoView({block: 'nearest'}); }
+  bringIntoView({page: m.page, rect: m.rects[0]});
+  countHits();
+}
+
+document.getElementById('find-btn').onclick = openSearch;
+document.getElementById('q-close').onclick = closeSearch;
+document.getElementById('q-next').onclick = () => goToHit(FOUND.at + 1);
+document.getElementById('q-prev').onclick = () => goToHit(FOUND.at - 1);
+document.getElementById('q-list').onclick = (e) => {
+  const box = document.getElementById('occur');
+  box.hidden = !box.hidden;
+  e.target.classList.toggle('on', !box.hidden);
+};
+document.getElementById('q').addEventListener('input', () => {
+  clearTimeout(searchWait);
+  searchWait = setTimeout(runSearch, 220);
+});
+document.getElementById('q').addEventListener('keydown', (e) => {
+  if (e.key === 'Enter') {
+    e.preventDefault();
+    clearTimeout(searchWait);
+    if (document.getElementById('q').value.trim() !== FOUND.q) { runSearch(); return; }
+    goToHit(FOUND.at + (e.shiftKey ? -1 : 1));
+  }
+});
+// / or Ctrl+F opens it: the browser's own find has only images to search here
+document.addEventListener('keydown', (e) => {
+  const typing = e.target.closest && e.target.closest('input, textarea, select');
+  if ((e.key === '/' && !typing) || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'f')) {
+    e.preventDefault();
+    openSearch();
+  }
+});
