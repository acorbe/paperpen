+// What the ink was before each stroke and each rub-out, so undo takes back
+// either. Snapshots of the list rather than of the strokes: a finished stroke
+// is never changed, only added or taken away, so sharing them is safe.
+let INK_UNDO = [];
+const UNDO_DEPTH = 200;
+
+function remember(stack, strokes) {
+  stack.push(strokes.slice());
+  if (stack.length > UNDO_DEPTH) stack.shift();
+}
