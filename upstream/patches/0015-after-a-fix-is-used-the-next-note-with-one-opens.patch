+// the first note after this one, by page and position, with a fix waiting;
+// from the top again if there is none further down
+function nextWithFixes(after) {
+  const list = notesInOrder().filter(n => n.id !== after.id && waitingFixes(n).length);
+  const key = n => [n.page, (n.rect && n.rect[1]) || 0];
+  const [p0, y0] = key(after);
+  return list.find(n => { const [p, y] = key(n); return p > p0 || (p === p0 && y > y0); })
+    || list[0] || null;
+}
