+// --- zooming the paper, and only the paper --------------------------------
+//
+// Resizing the pages around a point rather than scaling a picture of them:
+// the point on the paper that was under the fingers stays under them, and
+// the pages are the right size the moment the fingers lift. Which page the
+// point is on, and where on it, is what is kept: the gaps between the pages
+// do not grow with them, so a position down the whole column would drift.
+const pagesHost = document.getElementById('pages');
+
+function anchorAt(clientX, clientY) {
+  let best = null, gap = 1e9;
+  for (const el of document.querySelectorAll('.page')) {
+    const r = el.getBoundingClientRect();
+    const d = clientY < r.top ? r.top - clientY : clientY > r.bottom ? clientY - r.bottom : 0;
+    if (d < gap) { gap = d; best = {el: el, r: r}; }
+    if (!d) break;
+  }
+  if (!best) return null;
+  return {el: best.el, fx: (clientX - best.r.left) / best.r.width,
+          fy: (clientY - best.r.top) / best.r.height};
+}
+
+function zoomAround(scale, clientX, clientY, anchor) {
+  ZSCALE = Math.min(ZMAX, Math.max(ZMIN, scale));
+  const w = pageWidth();
+  for (const el of document.querySelectorAll('.page')) el.style.setProperty('--w', w + 'px');
+  document.getElementById('zoom-label').textContent = zoomLabel();
+  if (!anchor) return;
+  const r = anchor.el.getBoundingClientRect();
+  pagesHost.scrollLeft += r.left + anchor.fx * r.width - clientX;
+  pagesHost.scrollTop += r.top + anchor.fy * r.height - clientY;
+}
+
+// the buttons zoom about the middle of what is on screen
+function zoomBy(factor) {
+  const box = pagesHost.getBoundingClientRect();
+  const cx = box.left + box.width / 2, cy = box.top + box.height / 2;
+  let next = ZSCALE * factor;
+  if (Math.abs(next - 1) < 0.04) next = 1;
+  zoomAround(next, cx, cy, anchorAt(cx, cy));
+  relayout();
+}
+
+document.getElementById('zoom-in').onclick = () => zoomBy(ZSTEP);
+document.getElementById('zoom-out').onclick = () => zoomBy(1 / ZSTEP);
+
+// Two fingers on the paper. Never while the pen is in play, and never with a
+// palm among them: a hand resting on the glass beside the pen is two
+// contacts, and zooming the page under a sentence being written is the worst
+// thing this could do. The canvases redraw once, when the fingers lift; while
+// they move the ink is the picture of itself, stretched.
+let pinch = null;
+
+function twoFingers(e) {
+  if (e.touches.length !== 2) return null;
+  const [a, b] = e.touches;
+  if ([a, b].some(t => 2 * Math.max(t.radiusX || 0, t.radiusY || 0) > PALM_SIZE)) return null;
+  return {d: Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY),
+          x: (a.clientX + b.clientX) / 2, y: (a.clientY + b.clientY) / 2};
+}
+
+pagesHost.addEventListener('touchstart', (e) => {
+  const two = twoFingers(e);
+  if (!two || Date.now() - lastPenAt < PEN_GRACE || !two.d) return;
+  e.preventDefault();
+  pinch = {d: two.d, scale: ZSCALE, anchor: anchorAt(two.x, two.y)};
